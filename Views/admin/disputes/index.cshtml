<div class="ugrid" style="grid-template-columns:1fr"><div class="main"><div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div class="tabs">@foreach (var (__k1, __v1) in Blade.Pairs((object?)(Blade.Map((null, "All"), ("Open", "Open"), ("Under Review", "Under review"), ("Resolved", "Resolved"), ("Rejected", "Rejected"))))) { k = __k1; l = __v1;<text><a href="@(Blade.Route("admin.disputes", Php.ArrayFilter(Blade.Map(("status", Blade.Or(k, null))))))" style="text-decoration:none"><span class="@((Blade.Same(status, Blade.Or(k, null)) ? "on" : ""))">@(l) <span class="ct">@((Blade.Truthy(k) ? Blade.At(counts, k) ?? 0 : Blade.Coll(counts).Sum()))</span></span></a></text>}</div><a class="btn-f btn-ghost sm" href="@(Blade.Route("admin.reviews"))"><i class="bi bi-star"></i> Reviews</a></div>

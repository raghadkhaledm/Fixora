<tr><td><a href="@(Blade.Route("admin.disputes.show", d.Ticket_ID))" style="text-decoration:none"><b class="num">@(Blade.Get(d, "ref"))</b></a><br><span class="mini-l num">@(Blade.Get(Blade.Get(d, "booking"), "ref"))</span></td><td>@(d.Problem_Type)<br><span class="mini-l">@(Blade.StrLimit(d.Issue_Description, 60))</span></td><td>@(Blade.Get(Blade.Get(Blade.Get(d, "booking"), "homeowner"), "name"))<br><span class="mini-l">@(Blade.Get(Blade.Get(Blade.Get(d, "booking"), "technician"), "name"))</span></td><td class="num">@(Blade.Dt(d.Created_At).Format("j M Y, H:i"))</td><td><span class="ktag @(Fx.TagClass(d.Ticket_Status)) sm"><span class="hole"></span>@(d.Ticket_Status)</span>@if (Blade.Truthy(Blade.Get(d, "admin"))) {<text><br><span class="mini-l">@(Blade.Get(d, "admin").First_Name)</span></text>}</td><td><b class="num">@((!Blade.Same(d.Refund_Amount, null) ? Blade.Cat("SAR ", Fx.Money(d.Refund_Amount)) : "—"))</b><br><a class="mini-l" href="@(Blade.Route("admin.disputes.show", d.Ticket_ID))">@((Blade.Truthy(d.IsClosed()) ? "View" : "Handle"))</a></td></tr>
</text>}</text>} else {<text><tr><td colspan="6" style="text-align:center">No disputes.</td></tr></text>}
</tbody></table></div>
@await Html.PartialAsync("~/Views/vendor/pagination/fx.cshtml", (object)Blade.Props(("paginator", tickets), ("elements", Blade.Elements(tickets)), ("label", "tickets")))

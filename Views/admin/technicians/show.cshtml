@{
    Layout = "~/Views/layouts/app.cshtml";
    dynamic isPdf = Blade.Get(Model, "isPdf");
    dynamic type = Blade.Get(Model, "type");
    dynamic t = Blade.Get(Model, "t");
    dynamic label = Blade.Get(Model, "label");
    dynamic path = Blade.Get(Model, "path");
    dynamic jobs = Blade.Get(Model, "jobs");
    dynamic b = Blade.Get(Model, "b");
    var __push = new Dictionary<string, List<object>> { ["dialogs"] = new List<object>() };
    dynamic message = null;
}


@{
    isPdf = (Func<dynamic, dynamic>)((p_c) => Php.StrEndsWith(Php.Strtolower(Blade.ToStr(p_c)), ".pdf"));
    type = t.ServiceType();
}
@{ ViewData["title"] = Blade.Get(t, "name"); }
@section band {
@await Html.PartialAsync("~/Views/components/uhead.cshtml", (object)Blade.Props(("crumbs", Blade.List(Blade.List("Dashboard", Blade.Route("admin.dashboard")), Blade.List("Technicians", Blade.Route("admin.technicians")), Blade.Get(t, "name"))), ("title", Blade.Get(t, "name")), ("lead", Blade.Cat(t.TradeLabel(), " · ", t.City, " · registered ", Blade.Dt(t.Created_At).Format("j M Y")))))
}
@section content {
<div class="ugrid"><div class="main"><div class="d-flex justify-content-between align-items-start"><div><h2>Documents</h2><p class="lead2">National ID / Iqama <b class="num" style="color:var(--ink)">@(t.National_ID)</b> · phone @((Blade.Truthy(t.Phone_Verified_At) ? Blade.Cat("verified ", Blade.Dt(t.Phone_Verified_At).Format("j M Y")) : "not verified yet"))</p></div><span class="ktag @(Fx.TagClass(t.Verification_Status)) lg"><span class="hole"></span>@((Blade.Same(t.Verification_Status, "Pending") ? "Pending review" : t.Verification_Status))</span></div>
<div class="row g-3 mt-2">@foreach (var __t1 in Blade.Each((object?)(Blade.List(Blade.List("National ID · front & back", t.National_ID_File), Blade.List(Blade.Cat("Vocational license · ", type?.Type_Name ?? ""), t.Vocational_License))))) { label = Blade.At(__t1, 0); path = Blade.At(__t1, 1);<text><div class="col-6"><div class="card" style="padding:16px;background:var(--bg);box-shadow:none"><div class="sub-t" style="margin-bottom:10px">@(label)</div>@if (Blade.Truthy(isPdf(path))) {<text><object data="@(Fx.Url(path))" type="application/pdf" style="width:100%;height:260px;border-radius:12px;background:#fff"><a href="@(Fx.Url(path))" target="_blank" rel="noopener">Open PDF</a></object></text>} else {<text><a href="@(Fx.Url(path))" target="_blank" rel="noopener"><img src="@(Fx.Url(path))" alt="@(label)" style="width:100%;height:260px;object-fit:contain;border-radius:12px;background:#fff"></a></text>}<a class="btn-f btn-text mt-2" href="@(Fx.Url(path))" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> Open full size</a></div></div></text>}</div>
<form method="POST" action="@(Blade.Route("admin.technicians.verify", t.Technician_ID))" class="blk">@Html.AntiForgeryToken()<div class="blk-h"><h3>Decision</h3>@if (Blade.Truthy(t.Verified_At)) {<text><span class="opt mini-l">Approved @(Blade.Dt(t.Verified_At).Format("j M Y"))</span></text>}</div>
<div class="d-flex gap-2 flex-wrap" id="decision"><label class="fchip"><input type="radio" class="fx-hide" name="decision" value="Verified" @(Blade.Same(Blade.Old("decision", (Blade.Same(t.Verification_Status, "Verified") ? "Verified" : null)), "Verified") ? "checked" : "") required><i class="bi bi-patch-check"></i>Approve · Verified</label><label class="fchip"><input type="radio" class="fx-hide" name="decision" value="Rejected" @(Blade.Same(Blade.Old("decision"), "Rejected") ? "checked" : "")><i class="bi bi-x-circle"></i>Reject with a note</label></div>
@{ message = Blade.Errors.First("decision"); }@if (Blade.Errors.Has("decision")) {<text><div class="help err"><i class="bi bi-x-circle"></i> @(message)</div></text>}
<div class="field mt-3" data-fx-toggle-by="decision" data-fx-when="Rejected" @Html.Raw((!(Blade.Same(Blade.Old("decision"), "Rejected")) ? Blade.Cat(" hidden ") : ""))><label for="verification_note">Reason shown to the technician <span class="req">*</span></label><div class="input ta @((Blade.Truthy(Blade.Errors.Has("verification_note")) ? "error" : ""))" style="height:100px"><textarea id="verification_note" class="fx-in" name="verification_note" minlength="10" maxlength="300" data-fx-req data-fx-count="#vn-count" placeholder="e.g. The vocational license photo is not readable. Upload a clear copy of the full license.">@(Blade.Old("verification_note", t.Verification_Note))</textarea></div>@{ message = Blade.Errors.First("verification_note"); }@if (Blade.Errors.Has("verification_note")) {<text><div class="help err"><i class="bi bi-x-circle"></i> @(message)</div></text>} else {<text><div class="help d-flex justify-content-between"><span>Sent by SMS and shown on the technician's status page</span><span class="num" id="vn-count">0 / 300</span></div></text>}</div>
<div class="d-flex justify-content-end mt-3"><button type="submit" class="btn-f btn-blue sm" data-fx-busy="Saving…">Save decision</button></div></form>
<div class="blk"><div class="blk-h"><h3>Recent jobs</h3></div><div class="fx-scroll"><table class="tbl"><thead><tr><th>Booking</th><th>Service</th><th>Homeowner</th><th>Status</th><th>Total</th></tr></thead><tbody>@{ var __f2 = jobs; }@if (Blade.Count(__f2) > 0) {<text>@foreach (var __v3 in Blade.Each((object?)(__f2))) { b = __v3;<text><tr><td><a href="@(Blade.Route("admin.bookings.show", b.Booking_ID))" style="text-decoration:none"><b class="num">@(Blade.Get(b, "ref"))</b></a></td><td>@(b.ServiceName())</td><td>@(Blade.Get(Blade.Get(b, "homeowner"), "name"))</td><td><span class="ktag @(Fx.TagClass(b.StatusLabel())) sm"><span class="hole"></span>@(b.StatusLabel())</span></td><td class="num">SAR @(Fx.Money(Blade.Get(b, "invoice")?.Total_Amount ?? b.Estimate()))</td></tr></text>}</text>} else {<text><tr><td colspan="5" style="text-align:center">No jobs yet.</td></tr></text>}</tbody></table></div></div>
</div>
<aside><div class="sum"><div class="sh"><h3>Profile</h3><span class="ktag @(Fx.TagClass(t.Verification_Status)) sm"><span class="hole"></span>@(t.Verification_Status)</span></div><div style="padding:8px 24px 6px" class="d-flex gap-3 align-items-center"><div class="troof">@await Html.PartialAsync((string)"~/Views/svg/troof.cshtml", (object)Blade.Merge(Model, null, new Dictionary<string, object?> { ["isPdf"] = isPdf, ["type"] = type }))<span class="ava" style="@(t.AvaStyle());">@(Blade.Get(t, "initials"))</span></div><div><b style="font:800 17px/1.2 var(--f-head)">@(Blade.Get(t, "name"))</b><div class="mini-l">★ @((Blade.Truthy(t.Average_Rating) ? Php.NumberFormat(t.Average_Rating, 1) : "New")) · @(Blade.Get(t, "reviews_count")) reviews · @(Blade.Get(t, "jobs_count")) jobs</div></div></div>
<div class="srow"><span class="ic"><i class="bi bi-telephone"></i></span><div><small>Phone</small><b>@(Blade.Get(t, "phone_full"))</b></div></div><div class="srow"><span class="ic"><i class="bi bi-envelope"></i></span><div><small>Email</small><b style="word-break:break-all">@(t.Email)</b></div></div><div class="srow"><span class="ic"><i class="bi bi-geo-alt"></i></span><div><small>Coverage zones</small><b>@(Php.Implode(", ", Blade.Get(t, "zones"))) · @(t.City)</b></div></div><div class="srow"><span class="ic"><i class="bi bi-tools"></i></span><div><small>Services</small><b>@(Blade.Coll(Blade.Coll(Blade.Get(t, "services")).Pluck("Service_Name")).Implode(", "))</b></div></div><div class="srow"><span class="ic"><i class="bi bi-cash"></i></span><div><small>Hourly rate</small><b>SAR @(Fx.Amt(t.Hourly_Rate)) / hr</b></div></div><div style="height:12px"></div></div>
<a class="btn-f btn-ghost sm mt-3" href="#" data-fx-open="#fx-del-tech" style="width:100%;color:var(--danger);box-shadow:inset 0 0 0 1.5px #F0C5C5"><i class="bi bi-trash3"></i> Delete account</a></aside></div>
}
@{ StartTagHelperWritingScope(System.Text.Encodings.Web.HtmlEncoder.Default); }
@{ StartTagHelperWritingScope(System.Text.Encodings.Web.HtmlEncoder.Default); }<div class="mb"><h3>Delete @(t.First_Name)'s account?</h3><p>Personal data is anonymised; bookings, invoices and reviews stay for the records. Not possible while jobs or disputes are open.</p></div><form method="POST" action="@(Blade.Route("admin.technicians.destroy", t.Technician_ID))" class="mf">@Html.AntiForgeryToken() @Blade.Method("DELETE")<button type="button" class="btn-f btn-ghost sm" data-fx-close>Keep</button><button type="submit" class="btn-f btn-danger sm">Delete account</button></form>@{ var __slot1 = EndTagHelperWritingScope(); }@await Html.PartialAsync("~/Views/components/dialog.cshtml", (object)Blade.Props(("id", "fx-del-tech"), ("icon", "bi-trash3"), ("slot", __slot1)))
@{ __push["dialogs"].Add(EndTagHelperWritingScope()); }

@section dialogs { @foreach (var __pi in __push["dialogs"]) { @__pi } }
@{
    Layout = "~/Views/layouts/app.cshtml";
    dynamic l = Blade.Get(Model, "l");
    dynamic k = Blade.Get(Model, "k");
    dynamic status = Blade.Get(Model, "status");
    dynamic counts = Blade.Get(Model, "counts");
    dynamic techs = Blade.Get(Model, "techs");
    dynamic t = Blade.Get(Model, "t");
}



@{ ViewData["title"] = "Technicians"; }
@section band {
@await Html.PartialAsync("~/Views/components/uhead.cshtml", (object)Blade.Props(("crumbs", Blade.List(Blade.List("Dashboard", Blade.Route("admin.dashboard")), "Technicians")), ("title", "Technicians"), ("lead", "Verify documents, approve or reject with a note, and manage technician accounts.")))
}
@section content {
<div class="ugrid" style="grid-template-columns:1fr"><div class="main"><div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div class="tabs">@foreach (var (__k1, __v1) in Blade.Pairs((object?)(Blade.Map((null, "All"), ("Pending", "Pending"), ("Verified", "Verified"), ("Rejected", "Rejected"))))) { k = __k1; l = __v1;<text><a href="@(Blade.Route("admin.technicians", Php.ArrayFilter(Blade.Map(("status", Blade.Or(k, null)), ("q", Blade.Request("q"))))))" style="text-decoration:none"><span class="@((Blade.Same(status, Blade.Or(k, null)) ? "on" : ""))">@(l) <span class="ct">@((Blade.Truthy(k) ? Blade.At(counts, k) ?? 0 : Blade.Coll(counts).Sum()))</span></span></a></text>}</div>
<form method="GET" class="input" style="width:320px;height:46px;max-width:100%" data-fx-full>@if (Blade.Truthy(status)) {<text><input type="hidden" name="status" value="@(status)"></text>}<i class="bi bi-search li"></i><input class="fx-in" type="search" name="q" value="@(Blade.Request("q"))" placeholder="Search name, email or phone" maxlength="60" aria-label="Search technicians"></form></div>
<div class="fx-scroll"><table class="tbl"><thead><tr><th>Technician</th><th>Trade &amp; zones</th><th>Rating</th><th>Jobs</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@{ var __f2 = techs; }@if (Blade.Count(__f2) > 0) {<text>@foreach (var __v3 in Blade.Each((object?)(__f2))) { t = __v3;<text>
<tr><td><div class="who"><span class="ava" style="@(t.AvaStyle())">@(Blade.Get(t, "initials"))</span><div><b>@(Blade.Get(t, "name"))</b><br><span class="mini-l num">@(Blade.Get(t, "phone_full")) · @(t.Email)</span></div></div></td><td>@(t.TradeLabel()) · SAR @(Fx.Amt(t.Hourly_Rate))/hr<br><span class="mini-l">@(t.City) · @(Php.Implode(", ", Blade.Get(t, "zones")))</span></td><td class="num">@((Blade.Truthy(t.Average_Rating) ? Blade.Cat("★ ", Php.NumberFormat(t.Average_Rating, 1)) : "—"))<br><span class="mini-l">@(Blade.Get(t, "reviews_count")) reviews</span></td><td class="num">@(Blade.Get(t, "jobs_count"))</td><td><span class="ktag @(Fx.TagClass(t.Verification_Status)) sm"><span class="hole"></span>@(t.Verification_Status)</span>@if (Blade.Same(t.Verification_Status, "Verified")) {<text><br><span class="mini-l">@((Blade.Truthy(t.Is_Available) ? "Available now" : "Offline"))</span></text>}</td><td><a class="btn-f @((Blade.Same(t.Verification_Status, "Pending") ? "btn-key" : "btn-ghost")) sm" href="@(Blade.Route("admin.technicians.show", t.Technician_ID))">@((Blade.Same(t.Verification_Status, "Pending") ? "Review" : "View"))</a></td></tr>
</text>}</text>} else {<text><tr><td colspan="6" style="text-align:center">No technicians found.</td></tr></text>}
</tbody></table></div>
@await Html.PartialAsync("~/Views/vendor/pagination/fx.cshtml", (object)Blade.Props(("paginator", techs), ("elements", Blade.Elements(techs)), ("label", "technicians")))
</div></div>
}

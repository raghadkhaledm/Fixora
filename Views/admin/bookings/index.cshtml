@{
    Layout = "~/Views/layouts/app.cshtml";
    dynamic l = Blade.Get(Model, "l");
    dynamic k = Blade.Get(Model, "k");
    dynamic type = Blade.Get(Model, "type");
    dynamic status = Blade.Get(Model, "status");
    dynamic counts = Blade.Get(Model, "counts");
    dynamic bookings = Blade.Get(Model, "bookings");
    dynamic b = Blade.Get(Model, "b");
}



@{ ViewData["title"] = "Bookings"; }
@section band {
@await Html.PartialAsync("~/Views/components/uhead.cshtml", (object)Blade.Props(("crumbs", Blade.List(Blade.List("Dashboard", Blade.Route("admin.dashboard")), "Bookings")), ("title", "Bookings"), ("lead", "Every request on Fixora. Cancel any booking before it is completed.")))
}
@section content {
<div class="ugrid" style="grid-template-columns:1fr"><div class="main"><div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div class="tabs">@foreach (var (__k1, __v1) in Blade.Pairs((object?)(Blade.Map((null, "All"), ("Pending", "Pending"), ("Accepted", "Accepted"), ("Rejected", "Rejected"), ("Completed", "Completed"), ("Cancelled", "Cancelled"))))) { k = __k1; l = __v1;<text><a href="@(Blade.Route("admin.bookings", Php.ArrayFilter(Blade.Map(("status", Blade.Or(k, null)), ("type", type), ("q", Blade.Request("q"))))))" style="text-decoration:none"><span class="@((Blade.Same(status, Blade.Or(k, null)) ? "on" : ""))">@(l) <span class="ct">@((Blade.Truthy(k) ? Blade.At(counts, k) ?? 0 : Blade.Coll(counts).Sum()))</span></span></a></text>}</div>
<form method="GET" class="d-flex gap-2 flex-wrap" data-fx-autosubmit>@if (Blade.Truthy(status)) {<text><input type="hidden" name="status" value="@(status)"></text>}<div class="input" style="height:46px;width:170px"><i class="bi bi-funnel li"></i><select class="fx-in" name="type" aria-label="Booking type"><option value="">All types</option><option value="Express" @(Blade.Same(type, "Express") ? "selected" : "")>Express</option><option value="Scheduled" @(Blade.Same(type, "Scheduled") ? "selected" : "")>Scheduled</option></select></div><div class="input" style="height:46px;width:280px;max-width:100%"><i class="bi bi-search li"></i><input class="fx-in" type="search" name="q" value="@(Blade.Request("q"))" placeholder="FX-26-01873 or a name" maxlength="60" aria-label="Search bookings"></div></form></div>
<div class="fx-scroll"><table class="tbl"><thead><tr><th>Booking</th><th>Service</th><th>Homeowner</th><th>Technician</th><th>Date &amp; type</th><th>Status</th><th>Total</th></tr></thead><tbody>
@{ var __f2 = bookings; }@if (Blade.Count(__f2) > 0) {<text>@foreach (var __v3 in Blade.Each((object?)(__f2))) { b = __v3;<text>
<tr><td><a href="@(Blade.Route("admin.bookings.show", b.Booking_ID))" style="text-decoration:none"><b class="num">@(Blade.Get(b, "ref"))</b></a></td><td>@(b.ServiceName())<br><span class="mini-l">@(Blade.Get(b.Service(), "type")?.Type_Name)</span></td><td>@(Blade.Get(Blade.Get(b, "homeowner"), "name"))<br><span class="mini-l">@(b.Service_District)</span></td><td>@(Blade.Get(Blade.Get(b, "technician"), "name"))</td><td class="num">@(Blade.Dt((Blade.Truthy(b.IsExpress()) ? b.Created_At : b.Scheduled_Date_Time)).Format("j M Y, H:i"))<br>@if (Blade.Truthy(b.IsExpress())) {<text><span class="ktag solid sm mt-1"><span class="hole"></span>Express</span></text>} else {<text><span class="ktag indigo sm mt-1"><span class="hole"></span>Scheduled</span></text>}</td><td><span class="ktag @(Fx.TagClass(b.StatusLabel())) sm"><span class="hole"></span>@(b.StatusLabel())</span></td><td><b class="num">SAR @(Fx.Money(Blade.Get(b, "invoice")?.Total_Amount ?? ((Blade.Same(b.Status, "Cancelled") ? 0 : b.Estimate()))))</b>@if (Blade.Truthy(Blade.Get(b, "invoice"))) {<text><br><span class="mini-l">@(Blade.Get(b, "invoice").Payment_Status)</span></text>}</td></tr>
</text>}</text>} else {<text><tr><td colspan="7" style="text-align:center">No bookings found.</td></tr></text>}
</tbody></table></div>
@await Html.PartialAsync("~/Views/vendor/pagination/fx.cshtml", (object)Blade.Props(("paginator", bookings), ("elements", Blade.Elements(bookings)), ("label", "bookings")))
</div></div>
}

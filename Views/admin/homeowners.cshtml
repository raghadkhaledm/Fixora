@{
    Layout = "~/Views/layouts/app.cshtml";
    dynamic owners = Blade.Get(Model, "owners");
    dynamic o = Blade.Get(Model, "o");
}



@{ ViewData["title"] = "Homeowners"; }
@section band {
@await Html.PartialAsync("~/Views/components/uhead.cshtml", (object)Blade.Props(("crumbs", Blade.List(Blade.List("Dashboard", Blade.Route("admin.dashboard")), "Homeowners")), ("title", "Homeowners"), ("lead", "Households registered on Fixora, their bookings and points.")))
}
@section content {
<div class="ugrid" style="grid-template-columns:1fr"><div class="main"><div class="d-flex justify-content-end mb-3"><form method="GET" class="input" style="width:320px;height:46px;max-width:100%" data-fx-full><i class="bi bi-search li"></i><input class="fx-in" type="search" name="q" value="@(Blade.Request("q"))" placeholder="Search name or email" maxlength="60" aria-label="Search homeowners"></form></div>
<div class="fx-scroll"><table class="tbl"><thead><tr><th>Homeowner</th><th>Address</th><th>Phone</th><th>Bookings</th><th>Points</th><th>Member since</th></tr></thead><tbody>@{ var __f1 = owners; }@if (Blade.Count(__f1) > 0) {<text>@foreach (var __v2 in Blade.Each((object?)(__f1))) { o = __v2;<text><tr><td><div class="who"><span class="ava" style="@(o.AvaStyle())">@(Blade.Get(o, "initials"))</span><div><b>@(Blade.Get(o, "name"))</b><br><span class="mini-l">@(o.Email)</span></div></div></td><td>@(o.District), @(o.City)</td><td class="num">@(Blade.Get(o, "phone_full"))<br>@if (Blade.Truthy(o.Phone_Verified_At)) {<text><span class="ktag green sm"><span class="hole"></span>Verified</span></text>} else {<text><span class="ktag sm"><span class="hole"></span>Not verified</span></text>}</td><td class="num">@(Blade.Get(o, "bookings_count")) · @(Blade.Get(o, "completed_count")) done</td><td class="num">@(Php.NumberFormat(o.Loyalty_Points))<br><span class="mini-l">@(Fx.Level(o.Loyalty_Points))</span></td><td class="num">@(Blade.Dt(o.Created_At).Format("j M Y"))</td></tr></text>}</text>} else {<text><tr><td colspan="6" style="text-align:center">No homeowners found.</td></tr></text>}</tbody></table></div>
@await Html.PartialAsync("~/Views/vendor/pagination/fx.cshtml", (object)Blade.Props(("paginator", owners), ("elements", Blade.Elements(owners)), ("label", "homeowners")))
</div></div>
}

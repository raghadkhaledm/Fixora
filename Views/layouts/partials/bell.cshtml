@{
    dynamic fxRole = Blade.Get(Model, "fxRole") ?? Blade.Composed("fxRole");
    dynamic fxUnread = Blade.Get(Model, "fxUnread") ?? Blade.Composed("fxUnread");
    dynamic fxNotes = Blade.Get(Model, "fxNotes") ?? Blade.Composed("fxNotes");
    dynamic n = Blade.Get(Model, "n");
}
<div style="position:relative"><span class="bell" role="button" tabindex="0" aria-label="Notifications" data-fx-menu="#fx-bell" data-fx-seen="@(Blade.Route("notifications.seen", fxRole))"><i class="bi bi-bell"></i>@if (Blade.Truthy(fxUnread)) {<text><i class="d"></i></text>}</span><div id="fx-bell" class="dropdown fx-menu" data-fx-menu-box hidden style="right:0;top:46px;width:380px;max-width:calc(100vw - 32px);max-height:460px;overflow-y:auto"><div class="dd-group">Notifications</div>@{ var __f1 = fxNotes; }@if (Blade.Count(__f1) > 0) {<text>@foreach (var __v2 in Blade.Each((object?)(__f1))) { n = __v2;<text><a class="dd-item" href="@(Blade.Get(n, "url"))" style="text-decoration:none;align-items:flex-start;line-height:1.35@((Blade.Truthy(Blade.Get(n, "new")) ? ";background:var(--bg)" : ""))"><i class="bi @(Blade.Get(n, "icon"))" style="margin-top:1px"></i><span style="flex:1;min-width:0"><span style="display:block;font:600 14px/1.35 var(--f-body);color:var(--ink);white-space:normal">@(Blade.Get(n, "text"))</span><span class="mini-l" style="font-size:12px">@(Blade.Dt(Blade.Get(n, "at")).Format("D j M, H:i"))</span></span></a></text>}</text>} else {<text><div class="dd-item" style="color:var(--ink-3)"><i class="bi bi-bell-slash"></i>Nothing new yet</div></text>}</div></div>

@{
    Layout = "~/Views/layouts/app.cshtml";
    dynamic city = Blade.Get(Model, "city");
    dynamic o = Blade.Get(Model, "o");
    var __push = new Dictionary<string, List<object>> { ["dialogs"] = new List<object>() };
}


@{
    city = Blade.Old("city", o.City);
}
@{ ViewData["title"] = "My household"; }
@section band {
@await Html.PartialAsync("~/Views/components/uhead.cshtml", (object)Blade.Props(("crumbs", Blade.List(Blade.List("Home", Blade.Route("home")), "My household")), ("title", "My household"), ("lead", Blade.Cat("Member since ", Blade.Dt(o.Created_At).Format("M Y"), " · ", Fx.Level(o.Loyalty_Points), " member · ", Php.NumberFormat(o.Loyalty_Points), " points"))))
}
@section content {
<div class="ugrid"><div class="main">
<form method="POST" action="@(Blade.Route("account.update"))">@Html.AntiForgeryToken()<h2>Your household details</h2><p class="lead2">Technicians use your address to find your home. We never share your phone number before a job is accepted.</p>
@await Html.PartialAsync("~/Views/components/err-sum.cshtml", (object)Blade.Props(("style", "margin-top:18px"), ("fields", Blade.Map(("first_name", Blade.List("first_name", "First name", " needs letters only")), ("last_name", Blade.List("last_name", "Last name", " needs letters only")), ("email", Blade.List("email", "Email", " is not available")), ("phone", Blade.List("phone", "Phone number", " is not available")), ("address", Blade.List("address", "Home address", " is missing")), ("district", Blade.List("district", "District", " is missing"))))))
<div class="row g-3 mt-1"><div class="col-6">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "first_name"), ("label", "First name"), ("value", o.First_Name), ("req", true), ("minlength", "2"), ("maxlength", "50"), ("autocomplete", "given-name")))</div><div class="col-6">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "last_name"), ("label", "Last name"), ("value", o.Last_Name), ("req", true), ("minlength", "2"), ("maxlength", "50"), ("autocomplete", "family-name")))</div></div>
<div class="row g-3 mt-1"><div class="col-6">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "email"), ("label", "Email"), ("type", "email"), ("icon", "bi-envelope"), ("value", o.Email), ("req", true), ("maxlength", "150"), ("autocomplete", "email")))</div><div class="col-6">@{ StartTagHelperWritingScope(System.Text.Encodings.Web.HtmlEncoder.Default); }@if (Blade.Same(Blade.Errors.First("phone"), "This number already has a Fixora account.")) {<text></text>}@{ var __slot1 = EndTagHelperWritingScope(); }@await Html.PartialAsync("~/Views/components/phone.cshtml", (object)Blade.Props(("name", "phone"), ("value", o.Phone_Number), ("slot", __slot1)))</div></div>
<div class="row g-3 mt-1"><div class="col-8">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "address"), ("label", "Home address"), ("icon", "bi-house-door"), ("value", o.Address), ("req", true), ("minlength", "5"), ("maxlength", "200"), ("autocomplete", "street-address")))</div><div class="col-4">@await Html.PartialAsync((string)"~/Views/auth/partials/city-select.cshtml", (object)Blade.Merge(Model, Blade.Map(("name", "city"), ("value", city)), new Dictionary<string, object?> { ["city"] = city }))</div></div>
<div class="row g-3 mt-1"><div class="col-8">@await Html.PartialAsync((string)"~/Views/auth/partials/district-select.cshtml", (object)Blade.Merge(Model, Blade.Map(("name", "district"), ("city", city), ("value", Blade.Old("district", o.District))), new Dictionary<string, object?> { ["city"] = city }))</div><div class="col-4 d-flex align-items-end"><button type="submit" class="btn-f btn-blue" style="width:100%" data-fx-busy="Saving…">Save details</button></div></div>
<div class="help mt-2"><i class="bi bi-info-circle"></i> Changing the phone number needs a new SMS verification.</div></form>
<form method="POST" action="@(Blade.Route("account.password"))" class="blk">@Html.AntiForgeryToken()<div class="blk-h"><h3>Change password</h3></div><div class="row g-3"><div class="col-6">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "current_password"), ("label", "Current password"), ("type", "password"), ("icon", "bi-lock"), ("req", true), ("maxlength", "64"), ("autocomplete", "current-password")))</div><div class="col-6">@{ StartTagHelperWritingScope(System.Text.Encodings.Web.HtmlEncoder.Default); }<div class="pw-meter" data-fx-meter-for="password"><i></i><i></i><i></i><i></i></div>@if (!(Blade.Truthy(Blade.Errors.Has("password")))) {<text><div class="help" data-fx-strength-for="password" hidden></div></text>}@{ var __slot2 = EndTagHelperWritingScope(); }@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "password"), ("label", "New password"), ("type", "password"), ("icon", "bi-shield-lock"), ("req", true), ("minlength", "8"), ("maxlength", "64"), ("autocomplete", "new-password"), ("slot", __slot2)))</div></div><div class="d-flex justify-content-end mt-3"><button type="submit" class="btn-f btn-blue sm">Change password</button></div></form>
<div class="blk"><div class="blk-h"><h3>Saved card</h3></div>@if (Blade.Truthy(o.Credit_Card)) {<text><div class="payo"><span></span><span class="lg" style="background:#E2F0FB;color:#1F6FAE">@((Php.StrStartsWith(o.Credit_Card, "Mada") ? "mada" : Php.Strtolower(Blade.At(Php.Explode(" ", o.Credit_Card), 0))))</span><div><b>@(Blade.At(Php.Explode(" · ", o.Credit_Card), 0))</b><span class="d">Expires @(Blade.At(Php.Explode(" · ", o.Credit_Card), 1) ?? "") · only the masked label is stored</span></div><form method="POST" action="@(Blade.Route("account.card.remove"))" data-fx-confirm="Remove the saved card?">@Html.AntiForgeryToken()<button type="submit" class="btn-f btn-ghost sm" style="color:var(--danger)">Remove</button></form></div></text>} else {<text><p class="mini-l" style="font-size:14px">No saved card. Tick "Save this card" when you pay with a new card.</p></text>}</div>
<div class="blk"><div class="blk-h"><h3>Delete account</h3></div><p class="mini-l" style="font-size:14px">Your bookings, invoices and reviews stay for the records; your name, email, phone and address are removed. You need no open bookings or disputes.</p><a class="btn-f btn-ghost sm mt-3" href="#" data-fx-open="#fx-delete" style="color:var(--danger);box-shadow:inset 0 0 0 1.5px #F0C5C5"><i class="bi bi-trash3"></i> Delete my account</a></div>
</div>
<aside><div class="sum"><div class="sh"><h3>Your account</h3><span class="ktag green sm"><span class="hole"></span><i class="bi bi-check2"></i> Phone verified</span></div><div style="padding:8px 24px 6px" class="d-flex gap-3 align-items-center"><span class="ava" style="width:56px;height:56px;font-size:18px;@(o.AvaStyle())">@(Blade.Get(o, "initials"))</span><div><b style="font:800 17px/1.2 var(--f-head)">@(Blade.Get(o, "name"))</b><div class="mini-l">Homeowner · @(Blade.Get(o, "phone_full"))</div></div></div><div class="srow"><span class="ic"><i class="bi bi-geo-alt"></i></span><div><small>Coverage zone</small><b>@(o.District), @(o.City)</b></div></div><div class="srow"><span class="ic"><i class="bi bi-gift"></i></span><div><small>Points</small><b>@(Php.NumberFormat(o.Loyalty_Points)) · @(Fx.Level(o.Loyalty_Points))</b></div></div><div style="height:12px"></div></div></aside></div>
}
@{ StartTagHelperWritingScope(System.Text.Encodings.Web.HtmlEncoder.Default); }
@{ StartTagHelperWritingScope(System.Text.Encodings.Web.HtmlEncoder.Default); }<form method="POST" action="@(Blade.Route("account.delete"))"><div class="mb">@Html.AntiForgeryToken()<h3>Delete your account?</h3><p>This can't be undone. Type <b>DELETE</b> to confirm.</p>@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "confirm"), ("label", "Confirmation"), ("req", true), ("field-class", "mt-3"), ("placeholder", "DELETE"), ("pattern", "DELETE")))</div><div class="mf"><button type="button" class="btn-f btn-ghost sm" data-fx-close>Keep account</button><button type="submit" class="btn-f btn-danger sm">Delete account</button></div></form>@{ var __slot3 = EndTagHelperWritingScope(); }@await Html.PartialAsync("~/Views/components/dialog.cshtml", (object)Blade.Props(("id", "fx-delete"), ("icon", "bi-trash3"), ("open", Blade.Errors.Has("confirm")), ("slot", __slot3)))
@{ __push["dialogs"].Add(EndTagHelperWritingScope()); }

@section dialogs { @foreach (var __pi in __push["dialogs"]) { @__pi } }
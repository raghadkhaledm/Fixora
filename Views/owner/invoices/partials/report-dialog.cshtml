@{
    dynamic b = Blade.Get(Model, "b");
    dynamic inv = Blade.Get(Model, "inv");
    dynamic open = Blade.Get(Model, "open");
    dynamic sel = Blade.Get(Model, "sel");
    dynamic pt = Blade.Get(Model, "pt");
    dynamic message = null;
}

@{
    b = Blade.Get(inv, "booking");
    open = Blade.Truthy(Blade.Request().Boolean("report")) || Blade.Truthy(Blade.Errors.HasAny(Blade.List("problem_type", "issue_description", "refund_amount", "photo")));
    sel = Blade.Old("problem_type");
}
<div class="fx-dialog" id="fx-report" data-fx-dialog @Html.Raw((!(Blade.Truthy(open)) ? Blade.Cat(" hidden ") : ""))><form class="modal-f" style="width:640px" method="POST" action="@(Blade.Route("invoices.dispute", inv.Invoice_ID))" enctype="multipart/form-data">@Html.AntiForgeryToken()<div class="mh"><div class="ic" style="background:var(--orange-100);color:var(--orange-700)"><i class="bi bi-flag"></i></div><span class="x" role="button" tabindex="0" aria-label="Close" data-fx-close><i class="bi bi-x-lg"></i></span></div>
<div class="mb"><h3>Report a problem with this job</h3><p>A Fixora admin reviews every ticket within 24 hours. Approved refunds go back to the original payment method.</p>
<div class="sum"><div><b>@(b.ServiceName()) · @(Blade.Get(inv, "ref"))</b><span class="num">Paid SAR @(Fx.Money(inv.Total_Amount)) · @(inv.Payment_Method) · @(Blade.Get(Blade.Get(b, "technician"), "name"))</span></div><span class="ktag green sm"><span class="hole"></span><i class="bi bi-check2"></i> Paid</span></div>
<div class="sub-t" style="margin-top:20px" id="problem_type">What went wrong?</div><div class="d-flex gap-2 flex-wrap">@foreach (var __v1 in Blade.Each((object?)(Blade.Config("fixora.problem_types")))) { pt = __v1;<text><label class="fchip"><input type="radio" class="fx-hide" name="problem_type" value="@(pt)" @(Blade.Same(sel, pt) ? "checked" : "") required>@(pt)</label></text>}</div>
@{ message = Blade.Errors.First("problem_type"); }@if (Blade.Errors.Has("problem_type")) {<text><div class="help err"><i class="bi bi-x-circle"></i> @(message)</div></text>}
<div class="field mt-3"><label for="issue_description">Describe the issue <span class="req">*</span></label><div class="input ta @((Blade.Truthy(Blade.Errors.Has("issue_description")) ? "error" : ""))"><textarea id="issue_description" class="fx-in" name="issue_description" minlength="20" maxlength="500" required data-fx-count="#desc-count" placeholder="What happened, where, and when?">@(Blade.Old("issue_description"))</textarea></div>@{ message = Blade.Errors.First("issue_description"); }@if (Blade.Errors.Has("issue_description")) {<text><div class="help err"><i class="bi bi-x-circle"></i> @(message)</div></text>} else {<text><div class="help d-flex justify-content-between"><span>Be specific: what, where, when</span><span class="num" id="desc-count">0 / 500</span></div></text>}</div>
<div class="row g-3 mt-1"><div class="col-6"><div class="field"><label for="refund_amount">Requested refund (optional)</label><div class="input @((Blade.Truthy(Blade.Errors.Has("refund_amount")) ? "error" : ""))"><span style="color:var(--ink-3)">SAR</span><input id="refund_amount" class="fx-in num" name="refund_amount" type="number" min="0" max="@(inv.Total_Amount)" step="0.01" value="@(Blade.Old("refund_amount"))" placeholder="0.00"></div>@{ message = Blade.Errors.First("refund_amount"); }@if (Blade.Errors.Has("refund_amount")) {<text><div class="help err"><i class="bi bi-x-circle"></i> @(message)</div></text>} else {<text><div class="help">Up to SAR @(Fx.Money(inv.Total_Amount))</div></text>}</div></div>
<div class="col-6"><div class="field"><label for="photo">Add photos</label><div class="input @((Blade.Truthy(Blade.Errors.Has("photo")) ? "error" : ""))" style="position:relative"><i class="bi bi-camera li"></i><span data-fx-file-label>Add one photo (JPG or PNG)</span><span class="tr ktag green sm" data-fx-file-size hidden><span class="hole"></span><span></span></span><input id="photo" name="photo" type="file" class="fx-hide" accept="image/jpeg,image/png" data-fx-file><label for="photo" style="position:absolute;inset:0;margin:0;cursor:pointer" aria-label="Choose a photo"></label></div>@{ message = Blade.Errors.First("photo"); }@if (Blade.Errors.Has("photo")) {<text><div class="help err"><i class="bi bi-x-circle"></i> @(message)</div></text>}</div></div></div></div>
<div class="mf" style="justify-content:space-between"><a class="d-flex align-items-center gap-2" href="@(Fx.Whatsapp(Blade.Cat("Hi Fixora, I have a problem with ", Blade.Get(b, "ref"))))" target="_blank" rel="noopener" style="font:700 14px/1 var(--f-body);color:var(--success);text-decoration:none"><i class="bi bi-whatsapp"></i> Or chat on WhatsApp</a><div class="d-flex gap-2"><button type="button" class="btn-f btn-ghost sm" data-fx-close>Cancel</button><button type="submit" class="btn-f btn-key sm" data-fx-busy="Submitting…">Submit ticket</button></div></div></form></div>

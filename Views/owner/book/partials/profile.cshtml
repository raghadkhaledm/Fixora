@{
    dynamic type = Blade.Get(Model, "type");
    dynamic t = Blade.Get(Model, "t");
    dynamic fee = Blade.Get(Model, "fee");
    dynamic service = Blade.Get(Model, "service");
    dynamic km = Blade.Get(Model, "km");
    dynamic z = Blade.Get(Model, "z");
    dynamic s = Blade.Get(Model, "s");
    dynamic reviews = Blade.Get(Model, "reviews");
    dynamic rv = Blade.Get(Model, "rv");
    dynamic qty = Blade.Get(Model, "qty");
    dynamic express = Blade.Get(Model, "express");
    dynamic booking = Blade.Get(Model, "booking");
}

@{
    type = t.ServiceType();
    fee = service?.Service_Commission_Fee ?? Blade.Config("fixora.platform_fee");
}
<div class="prof-top"><div class="ph"><img src="@((Blade.Truthy(type) ? Php.StrReplace("w=600", "w=700", type.ImageUrl()) : ""))" alt="@(Blade.Get(t, "name")) at work"><span class="ktag green"><span class="hole"></span><i class="bi bi-patch-check-fill"></i> Verified</span></div>
<div style="padding:26px 28px"><div class="d-flex justify-content-between align-items-start"><div><h3 style="font-size:28px">@(Blade.Get(t, "name"))</h3><div class="mini-l" style="font-size:14.5px;margin-top:4px">@(t.TradeLabel()) · Member since @(Blade.Dt(t.Created_At).Format("M Y")) · @(Php.NumberFormat(km, 1)) km from you</div></div><span class="x" role="button" tabindex="0" aria-label="Close" data-fx-close style="width:38px;height:38px;border-radius:11px;background:var(--bg);display:grid;place-items:center;cursor:pointer"><i class="bi bi-x-lg"></i></span></div>
<div class="facts"><div><small>Rating</small><b class="num">@((Blade.Truthy(t.Average_Rating) ? Php.NumberFormat(t.Average_Rating, 1) : "New")) <span class="stars" style="font-size:16px">★</span></b></div><div><small>Reviews</small><b class="num">@(Blade.Get(t, "reviews_count"))</b></div><div><small>Jobs done</small><b class="num">@(Blade.Get(t, "jobs_count"))</b></div><div><small>Extra work</small><b class="num">SAR @(Fx.Amt(t.Hourly_Rate))/h</b></div></div>
<div class="d-flex gap-2 flex-wrap mt-3">@if (Blade.Truthy(t.Is_Available)) {<text><span class="avail" style="margin-right:6px"><i></i>Available now</span></text>} else {<text><span class="avail off" style="margin-right:6px"><i></i>Not available now</span></text>} @foreach (var __v1 in Blade.Each((object?)(Blade.Get(t, "zones")))) { z = __v1;<text><span class="ktag indigo sm"><span class="hole"></span>@(z)</span></text>}</div></div></div>
<div class="row g-0" style="border-top:1px solid var(--line)"><div class="col-12 col-lg-5" style="padding:22px 28px;border-right:1px solid var(--line)"><div class="sub-t">Verification</div><div class="vlist"><div class="vitem"><span class="c"><i class="bi bi-person-vcard"></i></span>National ID<span>Verified</span></div><div class="vitem"><span class="c"><i class="bi bi-award"></i></span>Vocational license · @(type?.Type_Name)<span>Verified</span></div><div class="vitem"><span class="c"><i class="bi bi-shield-check"></i></span>Approved by Fixora admin<span>@(Blade.Dt(t.Verified_At)?.Format("j M Y"))</span></div></div>
<div class="sub-t" style="margin-top:22px">Services offered</div>@{ var __li2 = new LoopInfo(Blade.Count(Blade.Coll(Blade.Coll(Blade.Get(t, "services")).Where("Is_Active", true)).Values())); }@foreach (var __v3 in Blade.Each((object?)(Blade.Coll(Blade.Coll(Blade.Get(t, "services")).Where("Is_Active", true)).Values()))) { var loop = __li2.Next(); s = __v3;<text><div class="svc-li" @Html.Raw((Blade.Truthy(loop.Last) ? Blade.Cat(" style=\"border:0\" ") : ""))>@(s.Service_Name)<span class="num">SAR @(Fx.Amt(s.Price))@((Blade.Same(s.Unit, "job") ? " fixed" : s.UnitSuffix()))</span></div></text>}</div>
<div class="col-12 col-lg-7" style="padding:22px 28px"><div class="d-flex justify-content-between"><div class="sub-t">Recent reviews</div><span class="mini-l">@(Blade.Get(t, "reviews_count")) verified @((Blade.Same(Blade.Get(t, "reviews_count"), 1) ? "booking" : "bookings"))</span></div><div class="d-flex flex-column gap-2">@{ var __f4 = reviews; }@if (Blade.Count(__f4) > 0) {<text>@foreach (var __v5 in Blade.Each((object?)(__f4))) { rv = __v5;<text><div class="rev"><div class="d-flex justify-content-between"><b>@(Fx.ShortName(Blade.Get(rv, "homeowner"))) · @(Blade.Get(rv, "booking")?.ServiceName())</b><span class="stars">@Html.Raw(Fx.Stars(rv.Rating_Score))</span></div>@if (Blade.Truthy(rv.Comment)) {<text><p>@(rv.Comment)</p></text>}</div></text>}</text>} else {<text><div class="rev"><b>No reviews yet</b><p>@(t.First_Name) is verified by Fixora. Reviews appear here after completed bookings.</p></div></text>}</div></div></div>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2" style="padding:18px 28px;background:var(--bg)"><span class="mini-l" style="font-size:14px">Your price: <b class="num" style="color:var(--ink)">SAR @(Fx.Amt((service?.Price ?? 0) * qty)) @((Blade.Truthy(service) && !Blade.Same(service.Unit, "job") ? Blade.Cat("(", service.QtyLabel(qty), ")") : "fixed"))</b>@if (Blade.Truthy(express)) {<text> + SAR @(Blade.Config("fixora.express_fee")) express </text>} + SAR @(Fx.Amt(fee)) platform fee</span><div class="d-flex gap-2"><button type="button" class="btn-f btn-ghost sm" data-fx-close>Back to list</button>@if (Blade.Truthy(booking)) {<text><form method="POST" action="@(Blade.Route("bookings.resend", booking.Booking_ID))" class="inline">@Html.AntiForgeryToken()<input type="hidden" name="technician_id" value="@(t.Technician_ID)"><button type="submit" class="btn-f btn-blue sm" data-fx-busy="Sending…">Send request to @(t.First_Name) <i class="bi bi-arrow-right"></i></button></form></text>} else {<text><form method="POST" action="@(Blade.Route("book.technician"))" class="inline">@Html.AntiForgeryToken()<input type="hidden" name="technician_id" value="@(t.Technician_ID)"><button type="submit" class="btn-f btn-blue sm" data-fx-busy="Selecting…">Select @(t.First_Name) <i class="bi bi-arrow-right"></i></button></form></text>}</div></div>

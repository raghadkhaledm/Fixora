@{ ViewData["title"] = "Home"; }
@section band {
@{ StartTagHelperWritingScope(System.Text.Encodings.Web.HtmlEncoder.Default); }<a class="btn-f btn-key" href="@(Blade.Route("book.start"))"><i class="bi bi-plus-lg"></i> Book a service</a>@{ var __slot1 = EndTagHelperWritingScope(); }@await Html.PartialAsync("~/Views/components/uhead.cshtml", (object)Blade.Props(("crumbs", Blade.List("Home")), ("title", Blade.Cat(greet, ", ", o.First_Name)), ("lead", (Blade.Truthy(Blade.Coll(active).Count()) ? Blade.Cat("You have ", Blade.Coll(active).Count(), " active ", (Blade.Same(Blade.Coll(active).Count(), 1) ? "booking" : "bookings"), ". We'll text you at every step.") : "Something broke? Book a verified technician in a few taps.")), ("slot", __slot1)))
}
@section content {
<div class="ugrid"><div class="main"><h2>Your active bookings</h2><p class="lead2">Requested, accepted and on-the-way jobs. Tap one to see the details.</p>
@{ var __f1 = active; }@if (Blade.Count(__f1) > 0) {<text>@foreach (var __v2 in Blade.Each((object?)(__f1))) { b = __v2;<text>
@{
    i = (Blade.Same(b.Status, "Accepted") ? b.ProgressIndex() : 0);
    p = Blade.At(Blade.List("8%", "30%", "52%", "74%", "100%"), i);
}

@{
    Layout = "~/Views/layouts/app.cshtml";
    dynamic b = Blade.Get(Model, "b");
    dynamic inv = Blade.Get(Model, "inv");
    dynamic t = Blade.Get(Model, "t");
    dynamic saved = Blade.Get(Model, "saved");
    dynamic owner = Blade.Get(Model, "owner");
    dynamic method = Blade.Get(Model, "method");
    dynamic declined = Blade.Get(Model, "declined");
    dynamic cardErr = Blade.Get(Model, "cardErr");
    dynamic amount = Blade.Get(Model, "amount");
    dynamic payTitle = Blade.Get(Model, "payTitle");
    var __push = new Dictionary<string, List<object>> { ["dialogs"] = new List<object>() };
    dynamic message = null;
}


@{
    b = Blade.Get(inv, "booking");
    t = Blade.Get(b, "technician");
    saved = (Blade.Truthy(owner.Credit_Card) ? PaymentService.SavedCard(owner.Credit_Card) : null);
    method = Blade.Old("method", (Blade.Truthy(declined) ? "stc" : null));
    cardErr = Blade.Errors.HasAny(Blade.List("card_number", "card_expiry", "card_cvv", "card_name"));
    amount = Fx.Money(inv.Total_Amount);
    payTitle = (Blade.Truthy(declined) ? "Payment didn't go through" : "Pay for your repair");
}
@{ ViewData["title"] = "Pay for your repair"; }
@{ ViewData["nav"] = "bookings"; }
@section band {
@await Html.PartialAsync("~/Views/components/uhead.cshtml", (object)Blade.Props(("crumbs", Blade.List(Blade.List("Home", Blade.Route("home")), Blade.List("My bookings", Blade.Route("bookings.index")), Blade.List(Blade.Get(b, "ref"), Blade.Route("bookings.show", b.Booking_ID)), "Payment")), ("title", payTitle), ("lead", (Blade.Truthy(declined) ? "Nothing was charged. Your invoice is still unpaid." : "Choose online or cash. The amount is the same."))))
@await Html.PartialAsync((string)"~/Views/owner/partials/pay-tracker.cshtml", (object)Blade.Merge(Model, Blade.Map(("b", b)), new Dictionary<string, object?> { ["b"] = b, ["t"] = t, ["saved"] = saved, ["method"] = method, ["cardErr"] = cardErr, ["amount"] = amount, ["payTitle"] = payTitle }))
}
@section content {
<form class="ugrid" method="POST" action="@(Blade.Route("invoices.pay.post", inv.Invoice_ID))" data-fx-overlay="#fx-processing" data-fx-pay>@Html.AntiForgeryToken()<div class="main"><h2>How would you like to pay?</h2><p class="lead2">Invoice @(Blade.Get(inv, "ref")) · @(b.ServiceName()) · @(Blade.Get(t, "name"))</p>
@if (Blade.Truthy(declined)) {<text><div class="alert-f err mt-3"><div class="ic"><i class="bi bi-x-octagon"></i></div><div><b>Payment declined by your bank</b><p>@(Blade.Get(declined, "label")) was declined (@(Blade.Get(declined, "reason"))). You haven't been charged. Try another method below.</p></div><span class="ktag red sm"><span class="hole"></span>Failed</span></div></text>}
@if (Blade.Truthy(cardErr)) {<text><div class="err-sum"><span class="ic"><i class="bi bi-credit-card"></i></span><div><b>Check your card details</b><ul>@{ message = Blade.Errors.First("card_number"); }@if (Blade.Errors.Has("card_number")) {<text><li><a href="#card_number">Card number</a> @((Php.StrContains(message, "incomplete") ? "is incomplete" : "is not valid"))</li></text>} @{ message = Blade.Errors.First("card_expiry"); }@if (Blade.Errors.Has("card_expiry")) {<text><li><a href="#card_expiry">Expiry date</a> @((Php.StrContains(message, "expired") ? "is in the past" : "is not valid"))</li></text>} @{ message = Blade.Errors.First("card_cvv"); }@if (Blade.Errors.Has("card_cvv")) {<text><li><a href="#card_cvv">CVV</a> is missing</li></text>} @{ message = Blade.Errors.First("card_name"); }@if (Blade.Errors.Has("card_name")) {<text><li><a href="#card_name">Name on card</a> is missing</li></text>}</ul></div></div></text>}
<div class="mt-4"><div class="paygrid" id="method">
@if (Blade.Truthy(saved)) {<text><label class="payo" data-method="Saved"><input type="radio" class="fx-hide" name="method" value="saved" data-label="Pay SAR @(amount)" data-with="@(Blade.At(saved, 1))" @(Blade.Same(method, "saved") ? "checked" : "") required><span class="radio"></span><span class="lg" style="background:#E2F0FB;color:#1F6FAE">@((Blade.Same(Blade.At(saved, 0), "Mada") ? "mada" : Php.Strtolower(Blade.At(Php.Explode(" ", Blade.At(saved, 1)), 0))))</span><div><b>@((Blade.Same(Blade.At(saved, 0), "Mada") ? "Mada debit" : Blade.At(Php.Explode(" ", Blade.At(saved, 1)), 0))) •••• @(Php.Substr(Blade.At(saved, 1), -4))</b><span class="d">Saved card · expires @(Blade.At(saved, 2))</span></div><span class="ktag indigo sm"><span class="hole"></span>Default</span></label></text>}
<label class="payo" data-method="STC"><input type="radio" class="fx-hide" name="method" value="stc" data-label="Pay SAR @(amount) with STC Pay" data-with="STC Pay" @(Blade.Same(method, "stc") ? "checked" : "") required><span class="radio"></span><span class="lg" style="background:#EDE4FA;color:#5B2BA3">stc pay</span><div><b>STC Pay</b><span class="d">Approve in the STC Pay app on @(Blade.Get(owner, "phone_masked"))</span></div></label>
<label class="payo" data-method="Card"><input type="radio" class="fx-hide" name="method" value="card" data-label="Pay SAR @(amount)" data-with="your card" @(Blade.Same(method, "card") ? "checked" : "")><span class="radio"></span><span class="lg" style="background:var(--indigo-100);color:var(--indigo)"><i class="bi bi-credit-card" style="font-size:18px"></i></span><div><b>New credit or debit card</b><span class="d">Visa, Mastercard or Mada</span></div></label>
<label class="payo" data-method="Cash"><input type="radio" class="fx-hide" name="method" value="cash" data-label="Pay SAR @(amount) in cash" data-cash @(Blade.Same(method, "cash") ? "checked" : "")><span class="radio"></span><span class="lg" style="background:var(--orange-100);color:var(--orange-700)"><i class="bi bi-cash-coin" style="font-size:19px"></i></span><div><b>Cash to the technician</b><span class="d">Hand over cash, then confirm with a one-time SMS code</span></div><span class="ktag sm"><span class="hole"></span>OTP</span></label>
</div>@{ message = Blade.Errors.First("method"); }@if (Blade.Errors.Has("method")) {<text><div class="help err"><i class="bi bi-x-circle"></i> @(message)</div></text>}</div>
@if (Blade.Truthy(saved)) {<text><div class="row g-3 mt-2" data-fx-toggle-by="method" data-fx-when="saved" @Html.Raw((!(Blade.Same(method, "saved")) ? Blade.Cat(" hidden ") : ""))><div class="col-6">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "saved_cvv"), ("label", Blade.Cat("CVV for •••• ", Php.Substr(Blade.At(saved, 1), -4))), ("icon", "bi-credit-card-2-back"), ("type", "password"), ("eye", false), ("req", false), ("star", true), ("data-fx-cvv", true), ("inputmode", "numeric"), ("maxlength", "3"), ("minlength", "3"), ("pattern", "[0-9]{3}"), ("autocomplete", "cc-csc"), ("placeholder", "•••"), ("data-fx-req", true), ("help", "3 digits on the back of the card")))</div><div class="col-6"><div class="field"><label>Receipt to</label><div class="input"><i class="bi bi-envelope li"></i><span style="overflow:hidden;text-overflow:ellipsis">@(owner.Email)</span></div></div></div></div></text>}
<div class="card mt-3" style="padding:20px;background:var(--bg);box-shadow:none" data-fx-toggle-by="method" data-fx-when="card" @Html.Raw((!(Blade.Same(method, "card")) ? Blade.Cat(" hidden ") : ""))>
@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "card_number"), ("label", "Card number"), ("icon", "bi-credit-card"), ("req", false), ("star", true), ("data-fx-card", true), ("data-fx-req", true), ("inputmode", "numeric"), ("maxlength", "19"), ("autocomplete", "cc-number"), ("placeholder", "1234 5678 9012 3456")))
<div class="row g-3 mt-1"><div class="col-4">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "card_expiry"), ("label", "Expiry"), ("req", false), ("star", true), ("data-fx-expiry", true), ("data-fx-req", true), ("inputmode", "numeric"), ("maxlength", "7"), ("autocomplete", "cc-exp"), ("placeholder", "MM / YY"), ("pattern", "(0[1-9]|1[0-2]) ?/ ?[0-9]{2}")))</div><div class="col-4">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "card_cvv"), ("label", "CVV"), ("type", "password"), ("eye", false), ("req", false), ("star", true), ("data-fx-cvv", true), ("data-fx-req", true), ("inputmode", "numeric"), ("maxlength", "3"), ("minlength", "3"), ("pattern", "[0-9]{3}"), ("autocomplete", "cc-csc"), ("placeholder", "•••")))</div><div class="col-4">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "card_name"), ("label", "Name on card"), ("data-fx-upper", true), ("data-fx-req", true), ("maxlength", "60"), ("autocomplete", "cc-name"), ("placeholder", "NAME ON CARD")))</div></div>
<label class="chk mt-3" style="font-weight:500;font-size:14.5px"><input type="checkbox" class="fx-hide" name="save_card" value="1" @(Blade.Truthy(Blade.Old("save_card", true)) ? "checked" : "")><span class="box"><i class="bi bi-check-lg"></i></span>Save this card to my household account</label>
</div>
<div class="actions"><a class="btn-f btn-ghost" href="@(Blade.Route("invoices.show", inv.Invoice_ID))"><i class="bi bi-arrow-left"></i> Back to invoice</a><span class="mini-l">Points are added once payment is confirmed</span></div>
</div>
<aside>@await Html.PartialAsync((string)"~/Views/owner/partials/tot-house.cshtml", (object)Blade.Merge(Model, Blade.Map(("inv", inv)), new Dictionary<string, object?> { ["b"] = b, ["t"] = t, ["saved"] = saved, ["method"] = method, ["cardErr"] = cardErr, ["amount"] = amount, ["payTitle"] = payTitle }))<div class="card" style="padding:20px;margin-top:-30px;position:relative"><button type="submit" class="btn-f @((Blade.Truthy(method) ? "btn-key" : "disabled")) lg" style="width:100%" data-fx-pay-btn data-fx-busy="Processing…" @(!Blade.Truthy(method) ? "disabled" : "")><i class="bi bi-lock-fill"></i> <span>@((Blade.Truthy(method) ? (Blade.Same(method, "stc") ? Blade.Cat("Pay SAR ", amount, " with STC Pay") : (Blade.Same(method, "cash") ? Blade.Cat("Pay SAR ", amount, " in cash") : Blade.Cat("Pay SAR ", amount))) : "Choose a payment method"))</span></button><div class="d-flex align-items-center justify-content-center gap-2 mt-3 mini-l"><i class="bi bi-shield-lock" style="color:var(--success)"></i><span>Encrypted with TLS 1.3 · card data never stored by Fixora</span></div></div></aside>
</form>
}
@{ StartTagHelperWritingScope(System.Text.Encodings.Web.HtmlEncoder.Default); }
<div class="fx-dialog" id="fx-processing" hidden><div class="load-card"><div style="position:relative;width:150px;height:140px;margin:0 auto">@await Html.PartialAsync((string)"~/Views/svg/status-ring-150x140.cshtml", (object)Blade.Merge(Model, null, new Dictionary<string, object?> { ["b"] = b, ["t"] = t, ["saved"] = saved, ["method"] = method, ["cardErr"] = cardErr, ["amount"] = amount, ["payTitle"] = payTitle }))<span class="spin o" style="position:absolute;left:55px;top:66px;width:40px;height:40px;border-width:6px"></span></div><h3 style="font-size:26px;margin-top:16px">Waiting for your bank…</h3><p class="mini-l" style="font-size:15px;margin-top:6px">Paying <b class="num" style="color:var(--ink)">SAR @(amount)</b> with <span data-fx-pay-with>@(Blade.At(saved, 1) ?? "your card")</span>. Don't close or refresh this page.</p><div class="d-flex flex-column gap-2 mt-4"><div class="lstep done"><span class="c"><i class="bi bi-check-lg"></i></span>Payment request sent to gateway</div><div class="lstep now"><span class="c"><span class="spin o"></span></span>Bank verification (3-D Secure)</div><div class="lstep todo"><span class="c"></span>Marking invoice as paid</div></div></div></div>
@{ __push["dialogs"].Add(EndTagHelperWritingScope()); }

@section dialogs { @foreach (var __pi in __push["dialogs"]) { @__pi } }
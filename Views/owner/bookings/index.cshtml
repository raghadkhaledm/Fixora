@{
    Layout = "~/Views/layouts/app.cshtml";
    dynamic l = Blade.Get(Model, "l");
    dynamic k = Blade.Get(Model, "k");
    dynamic tab = Blade.Get(Model, "tab");
    dynamic counts = Blade.Get(Model, "counts");
    dynamic bookings = Blade.Get(Model, "bookings");
    dynamic b = Blade.Get(Model, "b");
    dynamic inv = Blade.Get(Model, "inv");
}



@{ ViewData["title"] = "My bookings"; }
@section band {
@await Html.PartialAsync("~/Views/components/uhead.cshtml", (object)Blade.Props(("crumbs", Blade.List(Blade.List("Home", Blade.Route("home")), "My bookings")), ("title", "My bookings"), ("lead", "Every request you made, its status and its invoice.")))
}
@section content {
<div class="ugrid" style="grid-template-columns:1fr"><div class="main"><div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><div class="tabs">@foreach (var (__k1, __v1) in Blade.Pairs((object?)(Blade.Map(("all", "All bookings"), ("active", "Active"), ("completed", "Completed"), ("cancelled", "Cancelled"))))) { k = __k1; l = __v1;<text><a href="@(Blade.Route("bookings.index", Blade.Map(("tab", k))))" style="text-decoration:none"><span class="@((Blade.Same(tab, k) ? "on" : ""))">@(l)@if (Blade.Truthy(Blade.At(counts, k))) {<text> <span class="ct">@(Blade.At(counts, k))</span></text>}</span></a></text>}</div>
<form method="GET" action="@(Blade.Route("bookings.index"))" class="input" style="width:320px;height:46px;max-width:100%" data-fx-full><input type="hidden" name="tab" value="@(tab)"><i class="bi bi-search li"></i><input class="fx-in" type="search" name="q" value="@(Blade.Request("q"))" placeholder="Search by booking ID or service" maxlength="60" aria-label="Search bookings"></form></div>
<div class="fx-scroll"><table class="tbl"><thead><tr><th>Booking ID</th><th>Service</th><th>Technician</th><th>Date &amp; type</th><th>Status</th><th>Total</th></tr></thead><tbody>
@{ var __f2 = bookings; }@if (Blade.Count(__f2) > 0) {<text>@foreach (var __v3 in Blade.Each((object?)(__f2))) { b = __v3;<text>
@{
    inv = Blade.Get(b, "invoice");
}
<tr><td><a href="@(Blade.Route("bookings.show", b.Booking_ID))" style="text-decoration:none"><b class="num">@(Blade.Get(b, "ref"))</b></a></td><td>@(b.ServiceName())<br><span class="mini-l">@(Blade.Get(b.Service(), "type")?.Type_Name)</span></td><td><div class="who"><span class="ava" style="@(Blade.Get(b, "technician").AvaStyle())">@(Blade.Get(Blade.Get(b, "technician"), "initials"))</span><div><b>@(Blade.Get(Blade.Get(b, "technician"), "name"))</b><br><span class="mini-l">★ @((Blade.Truthy(Blade.Get(b, "technician").Average_Rating) ? Php.NumberFormat(Blade.Get(b, "technician").Average_Rating, 1) : "New"))</span></div></div></td><td class="num">@(Blade.Dt((Blade.Truthy(b.IsExpress()) ? b.Created_At : b.Scheduled_Date_Time)).Format("j M Y, H:i"))<br>@if (Blade.Truthy(b.IsExpress())) {<text><span class="ktag solid sm mt-1"><span class="hole"></span>Express</span></text>} else {<text><span class="ktag indigo sm mt-1"><span class="hole"></span>Scheduled</span></text>}</td><td><span class="ktag @(Fx.TagClass(b.StatusLabel()))"><span class="hole"></span>@(b.StatusLabel())</span>@if (Blade.Truthy(inv)) {<text><br><span class="mini-l">Invoice @(Php.Strtolower(inv.Payment_Status))</span></text>}</td><td>@if (Blade.Same(b.Status, "Cancelled")) {<text><b class="num" style="color:var(--ink-3)">SAR 0.00</b></text>} else {<text><b class="num">SAR @(Fx.Money((Blade.Truthy(inv) ? inv.Total_Amount : b.Estimate())))</b></text>}<br><a class="mini-l" href="@((Blade.Truthy(inv) && !Blade.Truthy(inv.IsPaid()) ? Blade.Route("invoices.show", inv.Invoice_ID) : Blade.Route("bookings.show", b.Booking_ID)))" style="@((Blade.Truthy(inv) && !Blade.Truthy(inv.IsPaid()) ? "color:var(--orange-700);font-weight:700" : ""))">@((Blade.Truthy(inv) && !Blade.Truthy(inv.IsPaid()) ? "Pay now" : "View"))</a></td></tr>
</text>}</text>} else {<text><tr><td colspan="6" style="text-align:center">No bookings here yet. <a href="@(Blade.Route("book.start"))">Book a service</a></td></tr></text>}
</tbody></table></div>
@await Html.PartialAsync("~/Views/vendor/pagination/fx.cshtml", (object)Blade.Props(("paginator", bookings), ("elements", Blade.Elements(bookings)), ("label", "bookings")))
</div></div>
}

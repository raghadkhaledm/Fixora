@{
    Layout = "~/Views/layouts/app.cshtml";
    dynamic rejected = Blade.Get(Model, "rejected");
    dynamic t = Blade.Get(Model, "t");
    dynamic docForm = Blade.Get(Model, "docForm");
    dynamic type = Blade.Get(Model, "type");
    var __push = new Dictionary<string, List<object>> { ["dialogs"] = new List<object>() };
}


@{
    rejected = Blade.Same(t.Verification_Status, "Rejected");
    docForm = Blade.Errors.HasAny(Blade.List("national_id", "national_id_file", "license_file", "services", "zones", "hourly_rate"));
}
@{ ViewData["title"] = "My profile"; }
@section band {
@await Html.PartialAsync("~/Views/components/uhead.cshtml", (object)Blade.Props(("crumbs", Blade.List("Profile")), ("title", "My profile"), ("lead", Blade.Cat(t.TradeLabel(), " · ", t.City, " · member since ", Blade.Dt(t.Created_At).Format("M Y")))))
}
@section content {
<div class="ugrid"><div class="main">
@if (Blade.Truthy(rejected)) {<text><div class="alert-f err mb-4" id="documents"><div class="ic"><i class="bi bi-file-earmark-x"></i></div><div><b>Your documents were rejected</b><p>@(t.Verification_Note) Upload new documents below to send your profile for review again.</p></div><span class="ktag red"><span class="hole"></span>Rejected</span></div></text>} else if (Blade.Same(t.Verification_Status, "Pending")) {<text><div class="alert-f warn mb-4"><div class="ic"><i class="bi bi-hourglass-split"></i></div><div><b>Your profile is in review</b><p>A Fixora admin checks your ID and license, usually within 48 h. You can still update your details.</p></div><span class="ktag"><span class="hole"></span>Pending review</span></div></text>}
<form method="POST" action="@(Blade.Route("tech.profile.update"))">@Html.AntiForgeryToken()<h2>Your details</h2><p class="lead2">Changing the phone number needs a new SMS verification.</p>
<div class="row g-3 mt-1"><div class="col-6">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "first_name"), ("label", "First name"), ("value", t.First_Name), ("req", true), ("minlength", "2"), ("maxlength", "50")))</div><div class="col-6">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "last_name"), ("label", "Last name"), ("value", t.Last_Name), ("req", true), ("minlength", "2"), ("maxlength", "50")))</div></div>
<div class="row g-3 mt-1"><div class="col-6">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "email"), ("label", "Email"), ("type", "email"), ("icon", "bi-envelope"), ("value", t.Email), ("req", true), ("maxlength", "150")))</div><div class="col-6">@await Html.PartialAsync("~/Views/components/phone.cshtml", (object)Blade.Props(("name", "phone"), ("value", t.Phone_Number)))</div></div>
<div class="d-flex justify-content-end mt-3"><button type="submit" class="btn-f btn-blue sm" data-fx-busy="Saving…">Save details</button></div></form>
@if (Blade.Truthy(type)) {<text>
<form method="POST" action="@(Blade.Route("tech.profile.documents"))" enctype="multipart/form-data" class="blk" @Html.Raw((!(Blade.Truthy(rejected)) ? Blade.Cat(" id=\"documents\" ") : ""))>@Html.AntiForgeryToken()<div class="blk-h"><h3>Services, zones &amp; documents</h3><span class="opt ktag @(Fx.TagClass(t.Verification_Status)) sm"><span class="hole"></span>@((Blade.Same(t.Verification_Status, "Pending") ? "Pending review" : t.Verification_Status))</span></div>
@await Html.PartialAsync((string)"~/Views/auth/partials/tech-documents.cshtml", (object)Blade.Merge(Model, Blade.Map(("type", type), ("city", t.City), ("v", Blade.Map(("national_id", t.National_ID), ("services", Blade.Coll(Blade.Coll(Blade.Get(t, "services")).Pluck("Service_ID")).All()), ("zones", Blade.Get(t, "zones")), ("rate", Blade.ToInt(t.Hourly_Rate)))), ("files", (Blade.Truthy(rejected) ? Blade.Map(("id", null), ("license", null)) : Blade.Map(("id", Php.Basename(t.National_ID_File)), ("license", Php.Basename(t.Vocational_License))))), ("needFiles", rejected)), new Dictionary<string, object?> { ["rejected"] = rejected, ["docForm"] = docForm }))
<div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2"><span class="mini-l"><a href="@(Fx.Url(t.National_ID_File))" target="_blank" rel="noopener">View current ID</a> · <a href="@(Fx.Url(t.Vocational_License))" target="_blank" rel="noopener">View current license</a></span><button type="submit" class="btn-f @((Blade.Truthy(rejected) ? "btn-key" : "btn-blue")) sm" data-fx-busy="Saving…">@((Blade.Truthy(rejected) ? "Submit for review" : "Save services & zones"))</button></div></form>
</text>}
<form method="POST" action="@(Blade.Route("tech.profile.password"))" class="blk">@Html.AntiForgeryToken()<div class="blk-h"><h3>Change password</h3></div><div class="row g-3"><div class="col-6">@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "current_password"), ("label", "Current password"), ("type", "password"), ("icon", "bi-lock"), ("req", true), ("maxlength", "64"), ("autocomplete", "current-password")))</div><div class="col-6">@{ StartTagHelperWritingScope(System.Text.Encodings.Web.HtmlEncoder.Default); }<div class="pw-meter" data-fx-meter-for="password"><i></i><i></i><i></i><i></i></div>@{ var __slot1 = EndTagHelperWritingScope(); }@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "password"), ("label", "New password"), ("type", "password"), ("icon", "bi-shield-lock"), ("req", true), ("minlength", "8"), ("maxlength", "64"), ("autocomplete", "new-password"), ("slot", __slot1)))</div></div><div class="d-flex justify-content-end mt-3"><button type="submit" class="btn-f btn-blue sm">Change password</button></div></form>
<div class="blk"><div class="blk-h"><h3>Delete account</h3></div><p class="mini-l" style="font-size:14px">Your jobs, invoices and reviews stay for the records; your name, email and phone are removed. You need no open jobs or disputes.</p><a class="btn-f btn-ghost sm mt-3" href="#" data-fx-open="#fx-delete" style="color:var(--danger);box-shadow:inset 0 0 0 1.5px #F0C5C5"><i class="bi bi-trash3"></i> Delete my account</a></div>
</div>
<aside>@if (Blade.Same(t.Verification_Status, "Verified")) {<text>@await Html.PartialAsync((string)"~/Views/tech/partials/profile-card.cshtml", (object)Blade.Merge(Model, Blade.Map(("t", t)), new Dictionary<string, object?> { ["rejected"] = rejected, ["docForm"] = docForm }))</text>} else {<text><div class="sum"><div class="sh"><h3>Your profile</h3><span class="ktag @(Fx.TagClass(t.Verification_Status)) sm"><span class="hole"></span>@(t.Verification_Status)</span></div><div class="srow"><span class="ic"><i class="bi bi-geo-alt"></i></span><div><small>Coverage zones</small><b>@(Php.Implode(", ", Blade.Get(t, "zones")))</b></div></div><div class="srow"><span class="ic"><i class="bi bi-cash"></i></span><div><small>Extra work</small><b>SAR @(Fx.Amt(t.Hourly_Rate)) / hr</b></div></div><div style="height:12px"></div></div><div class="side-note"><i class="bi bi-arrow-left"></i><span><a href="@(Blade.Route("tech.pending"))">Back to your review status</a></span></div></text>}</aside></div>
}
@{ StartTagHelperWritingScope(System.Text.Encodings.Web.HtmlEncoder.Default); }
@{ StartTagHelperWritingScope(System.Text.Encodings.Web.HtmlEncoder.Default); }<form method="POST" action="@(Blade.Route("tech.profile.delete"))"><div class="mb">@Html.AntiForgeryToken()<h3>Delete your account?</h3><p>This can't be undone. Type <b>DELETE</b> to confirm.</p>@await Html.PartialAsync("~/Views/components/field.cshtml", (object)Blade.Props(("name", "confirm"), ("label", "Confirmation"), ("req", true), ("field-class", "mt-3"), ("placeholder", "DELETE"), ("pattern", "DELETE")))</div><div class="mf"><button type="button" class="btn-f btn-ghost sm" data-fx-close>Keep account</button><button type="submit" class="btn-f btn-danger sm">Delete account</button></div></form>@{ var __slot2 = EndTagHelperWritingScope(); }@await Html.PartialAsync("~/Views/components/dialog.cshtml", (object)Blade.Props(("id", "fx-delete"), ("icon", "bi-trash3"), ("open", Blade.Errors.Has("confirm")), ("slot", __slot2)))
@{ __push["dialogs"].Add(EndTagHelperWritingScope()); }

@section dialogs { @foreach (var __pi in __push["dialogs"]) { @__pi } }
</head>
<body class="fx-public">
<div class="frame">

<header class="band">
@await Html.PartialAsync((string)"~/Views/svg/band-art.cshtml", (object)Blade.Merge(Model, null, new Dictionary<string, object?> { ["home"] = home, ["firstType"] = firstType }))
<div class="wrap">
<nav class="nav"><a href="@(Blade.Route("landing"))" class="d-flex"><img src="@(Blade.Asset("img/logo-on-dark.png"))" alt="Fixora" height="64"></a><div class="nav-links"><a class="active" href="#services">Services</a><a href="#how">How it works</a><a href="#pricing">Pricing</a><a href="#loyalty">Loyalty points</a><a href="#technicians">For technicians</a></div><div class="nav-right">@if (Blade.Truthy(home)) {<text><a class="btn-f btn-ghost-light btn-sm" href="@(home)">My account</a></text>} else {<text><a class="btn-f btn-ghost-light btn-sm" href="@(Blade.Route("login"))">Log in</a></text>}<a class="btn-f btn-key btn-sm" href="@(Blade.Route("book.start"))">Book a service</a><button type="button" class="fx-burger" data-fx-nav-toggle aria-label="Menu" aria-expanded="false"><i class="bi bi-list"></i></button></div></nav>
<div class="hero"><div><span class="ktag glass on-dark lg"><span class="hole"></span>Verified technicians in Riyadh, Jeddah &amp; Dammam</span><h1>Your home,<br>in <em>trusted</em> hands.</h1><p class="lead">Book ID-checked plumbers, electricians, painters and more. See the full price before you confirm, follow every step of the job, and pay online or in cash with a one-time code.</p><div class="hero-ctas"><a class="btn-f btn-key" href="@(Blade.Route("book.start", Blade.Map(("mode", "Express"))))"><i class="bi bi-lightning-charge-fill"></i> Get help now</a><a class="btn-f btn-ghost-light" href="@(Blade.Route("book.start", Blade.Map(("mode", "Scheduled"))))"><i class="bi bi-calendar3"></i> Schedule a visit</a></div><div class="hero-proof"><div class="avatars"><span style="background:#FFD9A0">NA</span><span style="background:#BFE0F7">FS</span><span style="background:#D8D1F2">MQ</span><span style="background:#C9EEDD">RH</span></div><div><span class="stars">★★★★★</span> <b style="color:#fff">@(Php.NumberFormat(Blade.Get(stats, "rating"), 1))</b> average rating<br>from @(Php.NumberFormat(Blade.Get(stats, "jobs")))+ completed jobs</div></div></div></div>
</div>
</header>
<div class="fx-backdrop" data-fx-nav-close></div>

<div class="wrap">
<form class="book-bar" method="GET" action="@(Blade.Route("book.start"))"><div class="book-bar-head"><h3>What needs fixing today?</h3><span class="ktag"><span class="hole"></span>Express fee: SAR @(Blade.Config("fixora.express_fee")), shown before you book</span></div>
<div class="book-grid">
<div class="field"><label for="bb-service">Service</label><div class="input"><i class="bi @(firstType?.Icon_Class ?? "bi-droplet-half") lead-i"></i><select id="bb-service" name="service" class="fx-in" required>@{ var __li1 = new LoopInfo(Blade.Count(types)); }@foreach (var __v2 in Blade.Each((object?)(types))) { var loop = __li1.Next(); t = __v2;<text><optgroup label="@(t.Type_Name)">@{ var __li3 = new LoopInfo(Blade.Count(Blade.Get(t, "services"))); }@foreach (var __v4 in Blade.Each((object?)(Blade.Get(t, "services")))) { var loop2 = __li3.Next(); s = __v4;<text><option value="@(s.Service_ID)" @(Blade.Truthy(Blade.Get(loop2.Parent, "first")) && Blade.Truthy(loop2.First) ? "selected" : "")>@(t.Type_Name) · @(s.Service_Name)</option></text>}</optgroup></text>}</select><i class="bi bi-chevron-down caret"></i></div></div>
<div class="field"><label for="bb-district">Service address</label><div class="input"><i class="bi bi-geo-alt-fill lead-i"></i><select id="bb-district" name="district" class="fx-in">@foreach (var (__k5, __v5) in Blade.Pairs((object?)(Blade.Config("fixora.cities")))) { city = __k5; districts = __v5;<text><optgroup label="@(city)">@foreach (var __v6 in Blade.Each((object?)(Php.ArrayKeys(districts)))) { d = __v6;<text><option value="@(d)" @(Blade.Truthy((Blade.Truthy(owner) ? Blade.Same(owner.District, d) && Blade.Same(owner.City, city) : Blade.Same(d, "Al Olaya"))) ? "selected" : "")>@(d), @(city)</option></text>}</optgroup></text>}</select><i class="bi bi-chevron-down caret"></i></div></div>
<div class="field"><label>When</label><div class="seg"><label><input type="radio" class="fx-hide" name="mode" value="Express" checked><span><i class="bi bi-lightning-charge-fill"></i>Express</span></label><label><input type="radio" class="fx-hide" name="mode" value="Scheduled"><span><i class="bi bi-calendar3"></i>Scheduled</span></label></div></div>
<button type="submit" class="btn-f btn-blue">See technicians &amp; prices <i class="bi bi-arrow-right"></i></button>
</div>
<div class="book-foot"><span><i class="bi bi-check-circle-fill"></i>Upfront price estimate</span><span><i class="bi bi-check-circle-fill"></i>Attach a photo of the problem</span><span><i class="bi bi-check-circle-fill"></i>Free cancellation before the technician accepts</span><span><i class="bi bi-check-circle-fill"></i>SMS update at every step</span></div>
</form>
<div class="stats"><div class="stat"><div class="v num">@(Php.NumberFormat(Blade.Get(stats, "technicians")))<span>+</span></div><div class="l">Verified technicians across 3 cities</div></div><div class="stat"><div class="v num">@(Php.NumberFormat(Blade.Get(stats, "jobs")))<span>+</span></div><div class="l">Jobs completed and invoiced</div></div><div class="stat"><div class="v num">SAR 0</div><div class="l">Hidden fees. Labor and materials always itemized</div></div><div class="stat"><div class="v num">@(Php.NumberFormat(Blade.Get(stats, "rating"), 1))<span>★</span></div><div class="l">Average rating from verified bookings</div></div></div>
</div>

<section class="sec" id="services"><div class="wrap"><div class="sec-head"><div><div class="eyebrow"><span class="ktag indigo"><span class="hole"></span>@(Blade.Coll(types).Count()) service categories</span></div><h2>One app for everything that breaks at home</h2></div><p>Every service has a clear base price set by Fixora. Pick what you need, and you'll see the estimate before any technician is booked.</p></div>
<div class="panel"><div class="svc-grid">@foreach (var __v7 in Blade.Each((object?)(types))) { t = __v7;<text><article class="svc"><a href="@(Blade.Route("book.service", t.Service_Type_ID))" style="color:inherit;text-decoration:none;display:contents"><img src="@(t.ImageUrl())" alt="@(t.Type_Name)"><div class="svc-body"><div class="svc-ic" style="@(t.IconStyle())"><i class="bi @(t.Icon_Class)"></i></div><h3>@(t.Type_Name)</h3><ul>@foreach (var __v8 in Blade.Each((object?)(Blade.Coll(Blade.Get(t, "services")).Take(3)))) { s = __v8;<text><li>@(s.Service_Name)</li></text>}</ul><div class="foot"><span class="ktag"><span class="hole"></span>@(t.FromLabel())</span></div></div></a></article></text>}</div></div>
</div></section>

<section class="sec" id="how"><div class="wrap"><div class="sec-head"><div><div class="eyebrow"><span class="ktag indigo"><span class="hole"></span>How it works</span></div><h2>From "it's leaking" to "it's fixed" in five steps</h2></div><p>The same key-line tracker follows your booking in the app, so you always know which step you're on.</p></div>
<div class="panel" style="padding:40px 40px 44px"><div class="keyshaft"><span class="ring"></span><span class="shaft"></span><div class="teeth"><div class="tooth"><div class="t"></div><div class="n">STEP 01</div><h4>Choose a service</h4><p>Pick the category, add a photo of the problem and your address.</p></div><div class="tooth"><div class="t" style="height:40px;margin-bottom:12px"></div><div class="n">STEP 02</div><h4>Pick a technician</h4><p>Filter by availability, distance and rating. Every profile is verified.</p></div><div class="tooth"><div class="t" style="height:22px;margin-bottom:30px"></div><div class="n">STEP 03</div><h4>See the price first</h4><p>Your upfront estimate shows the service rate, fees and the total.</p></div><div class="tooth"><div class="t" style="height:36px;margin-bottom:16px"></div><div class="n">STEP 04</div><h4>Track the job</h4><p>Accepted, on the way, in progress, completed. SMS at every stage.</p></div><div class="tooth"><div class="t" style="height:26px;margin-bottom:26px"></div><div class="n">STEP 05</div><h4>Pay &amp; earn points</h4><p>Pay online or in cash with an OTP, then collect loyalty points.</p></div></div></div></div>
</div></section>

<section class="sec"><div class="wrap"><div class="modes">
<article class="mode express"><span class="ktag solid"><span class="hole"></span><i class="bi bi-lightning-charge-fill"></i> Express</span><h3>Something broke right now?</h3><p class="d">Water leak at midnight or no cooking gas before dinner? We only show technicians who are available now in your area, nearest first.</p><div class="hero-n"><b class="num">@(expressAvg)</b><span>minutes average<br>arrival time in Riyadh</span></div><div class="fee-row"><span><i class="bi bi-info-circle" style="color:var(--orange);margin-right:8px"></i>Express dispatch fee</span><span class="num">+ SAR @(Fx.Money(Blade.Config("fixora.express_fee")))</span></div></article>
@{
    wk = Blade.Dt(Clock.Now()).StartOfWeek(DayOfWeek.Sunday);
}
<article class="mode"><span class="ktag blue"><span class="hole"></span><i class="bi bi-calendar3"></i> Scheduled</span><h3>Planning ahead? Pick your time.</h3><p class="d">Book a repaint, a new water heater or wardrobe assembly for the day and time slot that suits your household.</p><div class="week">@for (i = 0; i < 7; i++) {<text>@{
    d = Blade.Dt(Blade.Dt(wk).Copy()).AddDays(i);
}<div class="day @((Blade.Truthy(Blade.Dt(d).IsSameDay(Blade.Dt(Clock.Now()).AddDay())) ? "on" : ""))">@(Php.Strtoupper(Blade.Dt(d).Format("D")))<b>@(Blade.Dt(d).Format("j"))</b></div></text>}</div><div class="slots"><span class="slot off">08:00</span><span class="slot on">10:00 – 12:00</span><span class="slot">14:00</span><span class="slot">17:00</span></div></article>
</div></div></section>

<section class="sec" id="pricing"><div class="wrap"><div class="pricing"><div><div class="eyebrow"><span class="ktag indigo"><span class="hole"></span>Transparent pricing</span></div><h2 class="h2">You see the price before you hand over the keys</h2><ul class="checks"><li><span class="ck"><i class="bi bi-check-lg"></i></span><span><b>Upfront estimate:</b> the service rate, express fee and platform fee are all shown before you confirm.</span></li><li><span class="ck"><i class="bi bi-check-lg"></i></span><span><b>Itemized digital invoice:</b> labor and materials are listed separately, with nothing bundled.</span></li><li><span class="ck"><i class="bi bi-check-lg"></i></span><span><b>Disputes handled for you:</b> open a ticket from any invoice, and approved refunds go back the way you paid.</span></li></ul><div class="pay-chips"><span class="chip"><i class="bi bi-credit-card-2-front"></i>Mada</span><span class="chip"><i class="bi bi-phone"></i>STC Pay</span><span class="chip"><i class="bi bi-credit-card"></i>Credit card</span><span class="chip"><i class="bi bi-cash-coin"></i>Cash with OTP code</span></div></div>
<div class="receipt-house">@await Html.PartialAsync((string)"~/Views/svg/landing-receipt-house.cshtml", (object)Blade.Merge(Model, null, new Dictionary<string, object?> { ["home"] = home, ["firstType"] = firstType, ["d"] = d, ["wk"] = wk, ["i"] = i }))<span class="peak-str"></span><span class="peak-tag ktag solid"><span class="hole"></span>No hidden fees</span><div class="receipt"><div class="top"><div><small>Upfront estimate</small><b>Leak repair under kitchen sink</b><div style="font:500 13px/1.4 var(--f-body);color:var(--ink-3);margin-top:6px">Al Olaya, Riyadh · Express · Khalid Al-Harbi</div></div><span class="ktag blue num" style="height:28px;font-size:12px"><span class="hole"></span>FX-26-01873</span></div><div class="rline"><span>Leak repair × 1<span class="sub">Fixed service rate</span></span><b class="num">SAR 150.00</b></div><div class="rline"><span>Express dispatch fee</span><b class="num">SAR @(Fx.Money(Blade.Config("fixora.express_fee")))</b></div><div class="rline"><span>Platform service fee</span><b class="num">SAR @(Fx.Money(Blade.Config("fixora.platform_fee")))</b></div><div class="rline"><span>Materials<span class="sub">Listed on the invoice at cost, if any are used</span></span><b style="color:var(--ink-3)">on invoice</b></div><div class="rtotal"><span>Estimated total<br>before materials</span><b class="num"><small>SAR</small>@(Fx.Money((150 + Blade.Config("fixora.express_fee")) + Blade.Config("fixora.platform_fee")))</b></div></div></div>
</div></div></section>

<section class="sec"><div class="wrap"><div class="sec-head"><div><div class="eyebrow"><span class="ktag verified"><span class="hole"></span>Safety &amp; trust</span></div><h2>Verified before they ever knock on your door</h2></div><p>No technician appears in search until a Fixora admin has reviewed their national ID and vocational license.</p></div>
<div class="panel"><div class="verify">
@if (Blade.Truthy(tech)) {<text>
@{
    tType = tech.ServiceType();
}
<article class="tech-card"><div class="ph"><img src="@((Blade.Truthy(tType) ? Php.StrReplace("w=600", "w=900", tType.ImageUrl()) : ""))" alt="@(tech.TradeLabel()) at work"><span class="ktag verified"><span class="hole"></span><i class="bi bi-patch-check-fill"></i> Verified</span><span class="avail"><span class="dot"></span>Available now</span></div><div class="bd"><div class="d-flex justify-content-between align-items-start"><div><h3>@(Blade.Get(tech, "name"))</h3><div class="role">@(tech.TradeLabel()) · @(tType?.Description)</div></div><span class="ktag"><span class="hole"></span>SAR @(Fx.Amt(tech.Hourly_Rate)) / hr</span></div><div class="kv"><div><small>Rating</small><b class="num">@((Blade.Truthy(tech.Average_Rating) ? Php.NumberFormat(tech.Average_Rating, 1) : "New")) <span class="stars" style="font-size:15px;letter-spacing:0">★</span></b></div><div><small>Reviews</small><b class="num">@(Blade.Get(tech, "reviews_count"))</b></div><div><small>Jobs</small><b class="num">@(Blade.Get(tech, "jobs_count"))</b></div></div><div class="zones">@foreach (var __v9 in Blade.Each((object?)(Blade.Get(tech, "zones")))) { z = __v9;<text><span class="ktag indigo" style="height:28px;font-size:12px"><span class="hole"></span>@(z)</span></text>}</div><div class="actions"><a class="btn-f btn-ghost btn-sm" href="@(Blade.Route("book.service", tType?.Service_Type_ID ?? 1))">View reviews</a><a class="btn-f btn-key btn-sm" href="@(Blade.Route("book.service", tType?.Service_Type_ID ?? 1))">Book @(tech.First_Name)</a></div></div></article>
</text>}
<div class="vsteps"><div class="vstep"><div class="ic"><i class="bi bi-person-vcard"></i></div><div><h4>National ID checked</h4><p>The technician uploads a national ID or Iqama, which is matched to their registered phone number.</p></div><span class="ktag verified"><span class="hole"></span>Step 1</span></div><div class="vstep"><div class="ic"><i class="bi bi-award"></i></div><div><h4>Vocational license reviewed</h4><p>Their trade license is checked against the services they want to offer.</p></div><span class="ktag verified"><span class="hole"></span>Step 2</span></div><div class="vstep"><div class="ic"><i class="bi bi-shield-lock"></i></div><div><h4>Approved by a Fixora admin</h4><p>Only then does the profile go live in their coverage zones and become bookable.</p></div><span class="ktag verified"><span class="hole"></span>Step 3</span></div><div class="vstep" style="background:var(--indigo-100);box-shadow:none"><div class="ic" style="background:var(--card)"><i class="bi bi-star-half" style="color:var(--orange)"></i></div><div><h4>Rated after every job</h4><p>Only homeowners with a completed booking can leave a review, so every rating is real.</p></div><span class="ktag"><span class="hole"></span>Ongoing</span></div></div>
</div></div>
</div></section>

<section class="sec" id="loyalty"><div class="wrap"><div class="loyal"><div style="position:relative"><span class="ktag solid"><span class="hole"></span><i class="bi bi-gift"></i> Fixora Rewards</span><h2 class="h2" style="margin-top:18px">Every fixed problem earns you points</h2><p class="d">Points are added automatically once a job is confirmed complete. Redeem them for discounts on your next booking. No cards to carry, no codes to remember.</p><div class="pts-house">@await Html.PartialAsync((string)"~/Views/svg/pts-house.cshtml", (object)Blade.Merge(Model, null, new Dictionary<string, object?> { ["home"] = home, ["firstType"] = firstType, ["d"] = d, ["wk"] = wk, ["i"] = i, ["tType"] = tType }))<div class="val"><b class="num">1,240</b><span>points balance</span></div></div></div>
<div class="ledger" style="position:relative"><h4>Nora's points activity <span class="ktag indigo" style="height:28px;font-size:12px"><span class="hole"></span>Gold member</span></h4><div class="lrow"><div class="ic" style="background:var(--blue-100);color:var(--blue)"><i class="bi bi-droplet-half"></i></div><div><b>Leak repair completed</b><span>28 Sep 2026 · FX-26-01873</span></div><div class="p num" style="color:var(--success)">+175</div></div><div class="lrow"><div class="ic" style="background:var(--indigo-100);color:var(--indigo)"><i class="bi bi-hammer"></i></div><div><b>Wardrobe assembly completed</b><span>14 Sep 2026 · FX-26-01622</span></div><div class="p num" style="color:var(--success)">+105</div></div><div class="lrow"><div class="ic" style="background:var(--orange-100);color:var(--orange-700)"><i class="bi bi-ticket-perforated"></i></div><div><b>Redeemed: SAR 25 off</b><span>2 Sep 2026 · Gas delivery</span></div><div class="p num" style="color:var(--danger)">−500</div></div><div class="lrow"><div class="ic" style="background:#FFF4C2;color:#9A7A00"><i class="bi bi-paint-bucket"></i></div><div><b>Living room repaint completed</b><span>19 Aug 2026 · FX-26-01204</span></div><div class="p num" style="color:var(--success)">+520</div></div><a class="reward" href="@((Blade.Truthy(owner) ? Blade.Route("rewards") : Blade.Route("register")))" style="text-decoration:none"><span><b>760 more points</b> unlock SAR 100 off</span><i class="bi bi-arrow-right"></i></a></div>
</div></div></section>

<section class="sec"><div class="wrap"><div class="sec-head"><div><div class="eyebrow"><span class="ktag indigo"><span class="hole"></span>From verified bookings</span></div><h2>Homeowners who stopped searching for "a guy"</h2></div></div>
<div class="reviews"><article class="rev"><span class="stars">★★★★★</span><q>The pipe under our sink burst at 11 pm. Khalid arrived in 30 minutes, and the invoice matched the estimate except for one valve, which was listed separately.</q><div class="who"><div class="ava" style="background:#FFD9A0;color:var(--indigo)">NA</div><div><b>Nora Al-Otaibi</b><span>Plumbing · Al Olaya, Riyadh</span></div></div></article><article class="rev"><span class="stars">★★★★★</span><q>I scheduled a full repaint for Thursday morning. Seeing the painter's license and reviews before letting him in mattered a lot to my family.</q><div class="who"><div class="ava" style="background:#BFE0F7;color:var(--indigo)">FS</div><div><b>Faisal Al-Shehri</b><span>Painting · Al Rawdah, Jeddah</span></div></div></article><article class="rev"><span class="stars">★★★★<span style="color:var(--indigo-200)">★</span></span><q>I paid cash and confirmed it with the SMS code. No arguing about change, and the receipt was in the app right away. I also got 105 points.</q><div class="who"><div class="ava" style="background:#C9EEDD;color:var(--indigo)">MQ</div><div><b>Maha Al-Qahtani</b><span>Furniture assembly · Al Faisaliyah, Dammam</span></div></div></article></div>
</div></section>

<section class="sec" id="technicians"><div class="wrap"><div class="join"><div class="ph"><img src="https://images.unsplash.com/photo-1688372198189-de6a51777a81?auto=format&fit=crop&w=1100&q=80" alt="Painter rolling yellow paint on a wall"><span class="ktag solid lg"><span class="hole"></span>Ahmed S. · Painter · 96 jobs this year</span></div><div class="bd"><span class="ktag blue"><span class="hole"></span><i class="bi bi-tools"></i> For technicians</span><h2 class="h2" style="margin-top:18px;font-size:40px">Skilled with your hands? Let customers find you.</h2><ul><li><i class="bi bi-geo-alt-fill"></i>Set your own coverage zones</li><li><i class="bi bi-toggle-on"></i>Go available or offline in one tap</li><li><i class="bi bi-receipt"></i>Send invoices from your phone</li><li><i class="bi bi-graph-up-arrow"></i>Premium listing for SAR 400 / year</li></ul><div class="d-flex gap-3" data-fx-stack><a class="btn-f btn-key" href="@(Blade.Route("register", Blade.Map(("type", "technician"))))">Apply as a technician <i class="bi bi-arrow-right"></i></a><a class="btn-f btn-ghost" href="@(Blade.Route("register", Blade.Map(("type", "technician"))))">What documents do I need?</a></div><div class="jstats"><div><b class="num">1,180</b><span>Service requests in Riyadh last week</span></div><div><b class="num">SAR @(Blade.Config("fixora.platform_fee"))</b><span>Flat platform fee per completed job</span></div><div><b class="num">48 h</b><span>Typical ID &amp; license review time</span></div></div></div></div></div></section>

<footer class="footer"><div class="wrap"><div class="fgrid"><div><img src="@(Blade.Asset("img/logo-on-dark.png"))" alt="Fixora" height="56"><p style="font:400 15px/1.6 var(--f-body);margin-top:18px;max-width:260px">Verified home maintenance for Saudi households. Book, track, pay and earn, all in one place.</p></div>
<div><h5>Services</h5><ul>@foreach (var __v10 in Blade.Each((object?)(types))) { t = __v10;<text><li><a href="@(Blade.Route("book.service", t.Service_Type_ID))" style="color:inherit;text-decoration:none">@(t.Type_Name)</a></li></text>}</ul></div>

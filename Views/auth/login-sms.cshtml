@{
    Layout = "~/Views/layouts/auth.cshtml";
}


@{ ViewData["title"] = "Log in with an SMS code"; }
@section anav {<span>New to Fixora?</span><a class="btn-f btn-ghost-light sm" href="@(Blade.Route("register"))">Create account</a>}
@section aleft {
<span class="ktag glass lg"><span class="hole"></span>Verified home maintenance</span><h1>Your home,<br>in <em>trusted</em> hands.</h1><p class="lead">One account for booking, tracking and paying for repairs across Riyadh, Jeddah and Dammam.</p>@await Html.PartialAsync((string)"~/Views/auth/partials/trust-owner.cshtml", (object)Blade.Merge(Model, null, null))
}
@section card {
<form method="POST" action="@(Blade.Route("login.sms.send"))" class="acard">@Html.AntiForgeryToken()
<span class="ktag indigo"><span class="hole"></span>Homeowners &amp; technicians</span><h2 style="margin-top:16px">Log in with an SMS code</h2><p class="sub">We'll text a 6-digit code to the phone number on your Fixora account. It expires in 5 minutes.</p>
@await Html.PartialAsync("~/Views/components/phone.cshtml", (object)Blade.Props(("name", "phone")))
<button type="submit" class="btn-f btn-key lg mt-4" style="width:100%" data-fx-busy="Sending code…">Send code <i class="bi bi-arrow-right"></i></button>
<div class="or">OR</div>
<a class="btn-f btn-ghost" style="width:100%" href="@(Blade.Route("login"))"><i class="bi bi-lock"></i> Log in with a password</a>
<div class="afoot">New to Fixora? <a href="@(Blade.Route("register"))">Create an account</a></div>
</form>
}
